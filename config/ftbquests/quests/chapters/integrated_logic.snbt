			tasks: [{ id: "A140000000000078" type: "item" item: "integrateddynamics:variablestore" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000078" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A130000000000079"
			title: "Bateria sieciowa"
			description: ["Wcześniej udało ci się już zamknąć temat „Karty zmiennych”. Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Bateria sieciowa”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 15.0d
			y: 8.0d
			icon: "integrateddynamics:energy_battery"
