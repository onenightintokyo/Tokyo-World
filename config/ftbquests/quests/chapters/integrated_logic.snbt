		}
		{
			id: "A130000000000077"
			title: "Karty zmiennych"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Karty zmiennych”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 15.0d
			y: 4.0d
			icon: "integrateddynamics:variable"
			dependencies: ["A130000000000075"]
			tasks: [{ id: "A140000000000077" type: "item" item: "integrateddynamics:variable" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000077" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A130000000000078"
			title: "Magazyn zmiennych"
			description: ["Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Magazyn zmiennych”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
