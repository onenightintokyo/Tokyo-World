		}
		{
			id: "A1300000000000CE"
			title: "Skała galenowa"
			description: ["Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Skała galenowa”. Dobra wyprawa zaczyna się dużo wcześniej niż przy wejściu do lochu."]
			x: 1.0d
			y: 4.0d
			icon: "alexscaves:galena"
			dependencies: ["A1300000000000CD"]
			tasks: [{ id: "A1400000000000CE" type: "item" item: "alexscaves:galena" count: 16L consume_items: false }]
			rewards: [{ id: "A1500000000000CE" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A1300000000000CF"
			title: "Przysmak biomowy"
			description: ["Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Przysmak biomowy”. Przygotuj się tak, żeby było czym wrócić, nie tylko z czym wyruszyć."]
			x: 15.0d
			y: 4.0d
			icon: "alexscaves:biome_treat"
			dependencies: ["A1300000000000CD"]
			tasks: [{ id: "A1400000000000CF" type: "item" item: "alexscaves:biome_treat" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000CF" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A1300000000000D0"
			title: "Pancerz nurka"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Pancerz nurka”. Nie wszystko, co świeci w ciemności, jest skarbem."]
			x: 1.0d
			y: 8.0d
			icon: "alexscaves:diving_chestplate"
			dependencies: ["A1300000000000CE"]
			tasks: [{ id: "A1400000000000D0" type: "item" item: "alexscaves:diving_chestplate" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000D0" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000D1"
			title: "Rdzeń wulkaniczny"
			description: ["Wcześniej udało ci się już zamknąć temat „Przysmak biomowy”. Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Rdzeń wulkaniczny”. Dobra wyprawa zaczyna się dużo wcześniej niż przy wejściu do lochu."]
			x: 15.0d
			y: 8.0d
			icon: "alexscaves:volcanic_core"
			dependencies: ["A1300000000000CF"]
			tasks: [{ id: "A1400000000000D1" type: "item" item: "alexscaves:volcanic_core" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000D1" type: "item" item: "minecraft:glowstone_dust" count: 8 }]
		}
		{
			id: "A1300000000000D2"
			title: "Materiały syntetyczne"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Materiały syntetyczne”. Przygotuj się tak, żeby było czym wrócić, nie tylko z czym wyruszyć."]
			x: 1.0d
			y: 12.0d
			icon: "alexscaves:polymer_plate"
