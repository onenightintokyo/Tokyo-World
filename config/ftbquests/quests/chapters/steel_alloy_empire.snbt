			rewards: [{ id: "A150000000000178" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A130000000000179"
			title: "Warsztat obróbki"
			description: ["Stal w skrzyniach niczego nie zmieni, dopóki nie zacznie pracować w konstrukcji. W notatkach pojawia się „Warsztat obróbki”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 15.0d
			y: 4.0d
			icon: "immersiveengineering:workbench"
			dependencies: ["A130000000000177"]
			tasks: [{ id: "A140000000000179" type: "item" item: "immersiveengineering:workbench" count: 2L consume_items: false }, { id: "A180000000000179" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000179" type: "item" item: "minecraft:diamond" count: 1 }]
		}
		{
			id: "A13000000000017A"
			title: "Cewki wysokiego napięcia"
			description: ["Nawet najdroższa maszyna stanie, gdy zabraknie jej jednego porządnego elementu. Kolejny punkt planu to „Cewki wysokiego napięcia”. W hucie błędy kosztują sporo paliwa i jeszcze więcej cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "immersiveengineering:capacitor_hv"
