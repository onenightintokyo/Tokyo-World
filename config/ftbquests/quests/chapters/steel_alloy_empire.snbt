			rewards: [{ id: "A150000000000177" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A130000000000178"
			title: "Stal konstrukcyjna"
			description: ["Huta nabiera rozpędu. Przy takiej temperaturze na prowizorkę nie ma już miejsca. Tym razem liczy się „Stal konstrukcyjna”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 1.0d
			y: 4.0d
			icon: "immersiveengineering:ingot_steel"
