		{
			id: "A130000000000177"
			title: "Pierwsza huta"
			description: ["Najlepsze konstrukcje potrzebują materiałów, których nie znajdziesz w gotowej skrzyni. Zbuduj własne zaplecze hutnicze. Zacznij od sprawy „Pierwsza huta”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "immersiveengineering:blast_furnace"
			dependencies: ["A130000000000132", "A130000000000054"]
