			tasks: [{ id: "A14000000000017A" type: "item" item: "immersiveengineering:capacitor_hv" count: 2L consume_items: false }, { id: "A18000000000017A" type: "item" item: "minecraft:copper_ingot" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000017A" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A13000000000017B"
			title: "Kruszenie przemysłowe"
			description: ["Wcześniej zamknąłeś już sprawę „Warsztat obróbki”. Wielkie urządzenia potrzebują dobrego materiału i cierpliwego inżyniera. Warto teraz pomyśleć o „Kruszenie przemysłowe”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 15.0d
			y: 8.0d
