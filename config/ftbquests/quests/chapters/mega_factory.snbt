	quests: [
		{
			id: "A130000000000147"
			title: "Projekt hali"
			description: ["Warsztat robi się za ciasny. Potrzebujesz przestrzeni, w której kilka procesów może pracować równocześnie. Zacznij od sprawy „Projekt hali”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "minecraft:iron_block"
			dependencies: ["A130000000000030", "A130000000000044"]
			tasks: [{ id: "A140000000000147" type: "item" item: "minecraft:iron_block" count: 8L consume_items: false }, { id: "A180000000000147" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000147" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000148"
			title: "Wały produkcyjne"
			description: ["Ruch da się przekazać dalej, jeśli zbudujesz porządne połączenia. Zapisz w planie „Wały produkcyjne”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 1.0d
			y: 4.0d
			icon: "create:shaft"
			dependencies: ["A130000000000147"]
			tasks: [{ id: "A140000000000148" type: "item" item: "create:shaft" count: 32L consume_items: false }, { id: "A180000000000148" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000148" type: "item" item: "minecraft:emerald" count: 4 }]
		}
		{
			id: "A130000000000149"
			title: "Napęd mechaniczny"
			description: ["Wystarczy jeden źle ustawiony element, żeby cały napęd zmarnował swoją moc. Tym razem liczy się „Napęd mechaniczny”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
			x: 15.0d
			y: 4.0d
			icon: "create:water_wheel"
			dependencies: ["A130000000000147"]
			tasks: [{ id: "A140000000000149" type: "item" item: "create:water_wheel" count: 4L consume_items: false }, { id: "A180000000000149" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000149" type: "item" item: "create:andesite_alloy" count: 4 }]
		}
		{
			id: "A13000000000014A"
			title: "Prasy przemysłowe"
			description: ["Najpierw zaplanuj drogę materiału, potem dopiero stawiaj wokół niej maszyny. W notatkach pojawia się „Prasy przemysłowe”. Jeśli cały układ ma pracować sam, każde połączenie musi mieć sens."]
			x: 1.0d
			y: 8.0d
			icon: "create:mechanical_press"
			dependencies: ["A130000000000148"]
			tasks: [{ id: "A14000000000014A" type: "item" item: "create:mechanical_press" count: 4L consume_items: false }, { id: "A18000000000014A" type: "item" item: "minecraft:copper_ingot" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000014A" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A13000000000014B"
			title: "Ramiona robotyczne"
			description: ["Wcześniej zamknąłeś już sprawę „Napęd mechaniczny”. W hali słychać już przekładnie. Teraz trzeba sprawić, by nie zatrzymywały się co chwilę. Kolejny punkt planu to „Ramiona robotyczne”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 15.0d
			y: 8.0d
			icon: "create:deployer"
			dependencies: ["A130000000000149"]
			tasks: [{ id: "A14000000000014B" type: "item" item: "create:deployer" count: 4L consume_items: false }, { id: "A18000000000014B" type: "item" item: "minecraft:copper_ingot" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000014B" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A13000000000014C"
			title: "Taśmociąg główny"
			description: ["Przy coraz dłuższej linii produkcyjnej przydaje się więcej niż jedna para rąk. Warto teraz pomyśleć o „Taśmociąg główny”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
