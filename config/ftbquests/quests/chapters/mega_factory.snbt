			rewards: [{ id: "A150000000000147" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000148"
			title: "Wały produkcyjne"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Wały produkcyjne”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 1.0d
			y: 4.0d
			icon: "create:shaft"
			dependencies: ["A130000000000147"]
			tasks: [{ id: "A140000000000148" type: "item" item: "create:shaft" count: 32L consume_items: false }, { id: "A180000000000148" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000148" type: "item" item: "minecraft:emerald" count: 4 }]
		}
		{
			id: "A130000000000149"
			title: "Napęd mechaniczny"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Napęd mechaniczny”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
			x: 15.0d
			y: 4.0d
			icon: "create:water_wheel"
			dependencies: ["A130000000000147"]
			tasks: [{ id: "A140000000000149" type: "item" item: "create:water_wheel" count: 4L consume_items: false }, { id: "A180000000000149" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000149" type: "item" item: "create:andesite_alloy" count: 4 }]
		}
		{
			id: "A13000000000014A"
			title: "Prasy przemysłowe"
			description: ["Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Prasy przemysłowe”. Jeśli cały układ ma pracować sam, każde połączenie musi mieć sens."]
			x: 1.0d
			y: 8.0d
			icon: "create:mechanical_press"
			dependencies: ["A130000000000148"]
			tasks: [{ id: "A14000000000014A" type: "item" item: "create:mechanical_press" count: 4L consume_items: false }, { id: "A18000000000014A" type: "item" item: "minecraft:copper_ingot" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000014A" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A13000000000014B"
			title: "Ramiona robotyczne"
			description: ["Wcześniej udało ci się już zamknąć temat „Napęd mechaniczny”. Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Ramiona robotyczne”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 15.0d
			y: 8.0d
			icon: "create:deployer"
			dependencies: ["A130000000000149"]
			tasks: [{ id: "A14000000000014B" type: "item" item: "create:deployer" count: 4L consume_items: false }, { id: "A18000000000014B" type: "item" item: "minecraft:copper_ingot" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000014B" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A13000000000014C"
			title: "Taśmociąg główny"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Taśmociąg główny”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
			x: 1.0d
			y: 12.0d
