		}
		{
			id: "A130000000000134"
			title: "Rafinacja draconium"
			description: ["Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Rafinacja draconium”. Tu każde wcześniejsze odkrycie może znaleźć nowe zastosowanie."]
			x: 1.0d
			y: 4.0d
