			rewards: [{ id: "A150000000000134" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000135"
			title: "Rdzenie draconium"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Rdzenie draconium”. Nie budujesz już pojedynczej maszyny — składasz w całość cały dotychczasowy świat."]
			x: 15.0d
			y: 4.0d
			icon: "draconicevolution:draconium_core"
			dependencies: ["A130000000000133"]
