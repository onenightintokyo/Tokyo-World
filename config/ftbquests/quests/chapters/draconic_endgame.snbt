			rewards: [{ id: "A150000000000135" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A130000000000136"
			title: "Pierwsze iniektory"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Pierwsze iniektory”. Wielkie projekty są łatwiejsze, kiedy każdy z ekipy ma w nich własne zadanie."]
			x: 1.0d
			y: 8.0d
			icon: "draconicevolution:basic_crafting_injector"
			dependencies: ["A130000000000134"]
			tasks: [{ id: "A140000000000136" type: "item" item: "draconicevolution:basic_crafting_injector" count: 4L consume_items: false }]
			rewards: [{ id: "A150000000000136" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000137"
			title: "Rdzen syntezy"
			description: ["Wcześniej udało ci się już zamknąć temat „Rdzenie draconium”. Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Rdzen syntezy”. Tu każde wcześniejsze odkrycie może znaleźć nowe zastosowanie."]
			x: 15.0d
			y: 8.0d
