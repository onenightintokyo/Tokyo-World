			rewards: [{ id: "A1500000000001C7" type: "item" item: "minecraft:lapis_lazuli" count: 8 }]
		}
		{
			id: "A1300000000001C8"
			title: "Rozpraszacze many"
			description: ["Mana i Source potrafią wiele, jeśli nie próbujesz zmuszać ich do pośpiechu. Warto teraz pomyśleć o „Rozpraszacze many”. Kiedy już zrozumiesz źródło tej mocy, spróbuj wykorzystać je w bazie."]
			x: 1.0d
			y: 4.0d
			icon: "botania:mana_spreader"
			dependencies: ["A1300000000001C7"]
			tasks: [{ id: "A1400000000001C8" type: "item" item: "botania:mana_spreader" count: 4L consume_items: false }, { id: "A1800000000001C8" type: "item" item: "minecraft:lapis_lazuli" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001C8" type: "item" item: "botania:mana_diamond" count: 4 }]
		}
		{
			id: "A1300000000001C9"
			title: "Zbiorniki many"
			description: ["Nie każda moc daje się zamknąć w kablu. Tu przydają się uważne próby i eksperymenty. Zapisz w planie „Zbiorniki many”. Nawet najprostszy rytuał jest ciekawszy, gdy wiesz, po co go wykonujesz."]
			x: 15.0d
			y: 4.0d
			icon: "botania:mana_pool"
			dependencies: ["A1300000000001C7"]
			tasks: [{ id: "A1400000000001C9" type: "item" item: "botania:mana_pool" count: 6L consume_items: false }, { id: "A1800000000001C9" type: "item" item: "minecraft:lapis_lazuli" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001C9" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000001CA"
			title: "Diamenty many"
			description: ["Rytuał wymaga czegoś więcej niż przypadkowo ułożonych składników. Tym razem liczy się „Diamenty many”. Nie traktuj magii jak zwykłego przepisu — jej działanie często wymaga cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "botania:mana_diamond"
			dependencies: ["A1300000000001C8"]
