		}
		{
			id: "A1300000000000A5"
			title: "Ulepszone podłoże esencji"
			description: ["Nie przyspieszaj na siłę. Tu warto dopracować „Ulepszone podłoże esencji” — teraz pracujesz już nad prawdziwym systemem."]
			x: 15.0d
			y: 8.0d
