		{
			id: "A1300000000000A2"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Kryształy Prosperity"
			description: ["Gospodarstwo staje się coraz większe, więc nawet drobiazg potrafi ułatwić cały dzień. Kolejny punkt planu to „Kryształy Prosperity”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 2.12d
			y: 3.12d
			icon: "mysticalagriculture:prosperity_gemstone"
			dependencies: ["A1300000000000A1"]
