	quests: [
		{
			id: "A1300000000000A1"
			title: "Esencja Inferium"
			description: ["Niektóre plony dają więcej niż jedzenie. Magia roślin wymaga jednak cierpliwości i właściwego podłoża. Zacznij od sprawy „Esencja Inferium”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "mysticalagriculture:inferium_essence"
			dependencies: ["A13000000000001E"]
			tasks: [{ id: "A1400000000000A1" type: "item" item: "mysticalagriculture:inferium_essence" count: 48L consume_items: false }]
			rewards: [{ id: "A1500000000000A1" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A1300000000000A2"
			title: "Kryształy Prosperity"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Kryształy Prosperity”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "mysticalagriculture:prosperity_gemstone"
			dependencies: ["A1300000000000A1"]
			tasks: [{ id: "A1400000000000A2" type: "item" item: "mysticalagriculture:prosperity_gemstone" count: 4L consume_items: false }]
			rewards: [{ id: "A1500000000000A2" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A1300000000000A3"
			title: "Kryształ infuzji"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Kryształ infuzji”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "mysticalagriculture:infusion_crystal"
			dependencies: ["A1300000000000A1"]
			tasks: [{ id: "A1400000000000A3" type: "item" item: "mysticalagriculture:infusion_crystal" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000A3" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A1300000000000A4"
			title: "Pierwsze podłoże esencji"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Pierwsze podłoże esencji”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "mysticalagriculture:inferium_farmland"
			dependencies: ["A1300000000000A2"]
			tasks: [{ id: "A1400000000000A4" type: "item" item: "mysticalagriculture:inferium_farmland" count: 4L consume_items: false }]
			rewards: [{ id: "A1500000000000A4" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000A5"
			title: "Ulepszone podłoże esencji"
			description: ["Wcześniej udało ci się już zamknąć temat „Kryształ infuzji”. Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Ulepszone podłoże esencji”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "mysticalagriculture:prudentium_farmland"
			dependencies: ["A1300000000000A3"]
			tasks: [{ id: "A1400000000000A5" type: "item" item: "mysticalagriculture:prudentium_farmland" count: 4L consume_items: false }]
			rewards: [{ id: "A1500000000000A5" type: "item" item: "minecraft:honeycomb" count: 8 }]
		}
		{
			id: "A1300000000000A6"
			title: "Ołtarz infuzji"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Ołtarz infuzji”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 1.0d
			y: 12.0d
			icon: "mysticalagriculture:infusion_altar"
			dependencies: ["A1300000000000A4"]
			tasks: [{ id: "A1400000000000A6" type: "item" item: "mysticalagriculture:infusion_altar" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000A6" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A1300000000000A7"
			title: "Piedestały infuzji"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Piedestały infuzji”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 15.0d
			y: 12.0d
			icon: "mysticalagriculture:infusion_pedestal"
			dependencies: ["A1300000000000A5"]
			tasks: [{ id: "A1400000000000A7" type: "item" item: "mysticalagriculture:infusion_pedestal" count: 4L consume_items: false }]
			rewards: [{ id: "A1500000000000A7" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000A8"
			title: "Naczynie esencji"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Naczynie esencji”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 16.0d
			icon: "mysticalagriculture:essence_vessel"
			dependencies: ["A1300000000000A6", "A1300000000000A7"]
			tasks: [{ id: "A1400000000000A8" type: "item" item: "mysticalagriculture:essence_vessel" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000A8" type: "item" item: "minecraft:honeycomb" count: 4 }]
		}
		{
			id: "A1300000000000A9"
			title: "Przerób nasion"
			description: ["Wcześniej udało ci się już zamknąć temat „Naczynie esencji”. Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Przerób nasion”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 1.0d
			y: 20.0d
			icon: "mysticalagriculture:seed_reprocessor"
