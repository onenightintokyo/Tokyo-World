		}
		{
			id: "A130000000000111"
			title: "Szuflada magazynowa"
			description: ["Nie wszystko da się zrobić jedną maszyną. Zajmij się „Szuflada magazynowa” zanim kolejny pomysł zamieni się w stertę niedokończonych maszyn."]
