			rewards: [{ id: "A15000000000010E" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A13000000000010F"
			title: "Kapusta"
			description: ["Nie trzeba od razu budować wielkiego zakładu. Na razie skup się na „Kapusta” na tyle solidnie, żeby nie trzeba było do tego wracać po godzinie."]
			x: 15.0d
			y: 12.0d
