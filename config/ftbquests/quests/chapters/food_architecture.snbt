		}
		{
			id: "A13000000000010B"
			title: "Piec kuchenny"
			description: ["Najlepsze rozwiązania bywają niepozorne. Przyjrzyj się „Piec kuchenny” — kiedy zabraknie go później, cała linia stanie w miejscu."]
			x: 15.0d
			y: 4.0d
			icon: "farmersdelight:stove"
			dependencies: ["A130000000000109"]
			tasks: [{ id: "A14000000000010B" type: "item" item: "farmersdelight:stove" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000010B" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A13000000000010C"
			title: "Garnek do gotowania"
			description: ["W fabryce zawsze znajdzie się jakieś wąskie gardło. Spróbuj wykorzystać „Garnek do gotowania” zanim przejdziesz dalej. Później wszystko powinno się ze sobą połączyć."]
			x: 1.0d
			y: 8.0d
			icon: "farmersdelight:cooking_pot"
			dependencies: ["A13000000000010A"]
			tasks: [{ id: "A14000000000010C" type: "item" item: "farmersdelight:cooking_pot" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000010C" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A13000000000010D"
			title: "Ryż"
			description: ["Nie przyspieszaj na siłę. Tu warto dopracować „Ryż” — teraz pracujesz już nad prawdziwym systemem."]
			x: 15.0d
			y: 8.0d
			icon: "farmersdelight:rice"
