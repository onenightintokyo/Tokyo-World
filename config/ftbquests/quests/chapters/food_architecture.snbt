			rewards: [{ id: "A15000000000010D" type: "item" item: "minecraft:honeycomb" count: 8 }]
		}
		{
			id: "A13000000000010E"
			title: "Pomidory"
			description: ["Dobrze mieć pomysł, lecz jeszcze lepiej zobaczyć go w praktyce. Przygotuj „Pomidory” i pomyśl, jak ten element przyda ci się przy następnej budowie."]
			x: 1.0d
			y: 12.0d
			icon: "farmersdelight:tomato"
