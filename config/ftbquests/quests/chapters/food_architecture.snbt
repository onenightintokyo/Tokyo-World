		}
		{
			id: "A13000000000010A"
			title: "Patelnia"
			description: ["Przy większej produkcji drobiazgi decydują o wszystkim. Wróć do tematu „Patelnia” i daj sobie chwilę na sprawdzenie efektu."]
			x: 1.0d
			y: 4.0d
			icon: "farmersdelight:skillet"
