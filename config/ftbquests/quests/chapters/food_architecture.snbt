	quests: [
		{
			id: "A130000000000109"
			title: "Deska do krojenia"
			description: ["Złóż bazę, w której naprawdę warto mieszkać. Warsztat potrzebuje kuchni, schowków i miejsca na odpoczynek. Zacznij od sprawy „Deska do krojenia”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "farmersdelight:cutting_board"
			dependencies: ["A130000000000019"]
			tasks: [{ id: "A140000000000109" type: "item" item: "farmersdelight:cutting_board" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000109" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A13000000000010A"
			title: "Patelnia"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Patelnia”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "farmersdelight:skillet"
			dependencies: ["A130000000000109"]
			tasks: [{ id: "A14000000000010A" type: "item" item: "farmersdelight:skillet" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000010A" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A13000000000010B"
			title: "Piec kuchenny"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Piec kuchenny”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "farmersdelight:stove"
			dependencies: ["A130000000000109"]
			tasks: [{ id: "A14000000000010B" type: "item" item: "farmersdelight:stove" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000010B" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A13000000000010C"
			title: "Garnek do gotowania"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Garnek do gotowania”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "farmersdelight:cooking_pot"
			dependencies: ["A13000000000010A"]
			tasks: [{ id: "A14000000000010C" type: "item" item: "farmersdelight:cooking_pot" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000010C" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A13000000000010D"
			title: "Ryż"
			description: ["Wcześniej udało ci się już zamknąć temat „Piec kuchenny”. Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Ryż”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "farmersdelight:rice"
			dependencies: ["A13000000000010B"]
			tasks: [{ id: "A14000000000010D" type: "item" item: "farmersdelight:rice" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000010D" type: "item" item: "minecraft:honeycomb" count: 8 }]
		}
		{
			id: "A13000000000010E"
			title: "Pomidory"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Pomidory”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 1.0d
			y: 12.0d
			icon: "farmersdelight:tomato"
			dependencies: ["A13000000000010C"]
			tasks: [{ id: "A14000000000010E" type: "item" item: "farmersdelight:tomato" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000010E" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A13000000000010F"
			title: "Kapusta"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Kapusta”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 15.0d
			y: 12.0d
			icon: "farmersdelight:cabbage"
			dependencies: ["A13000000000010D"]
			tasks: [{ id: "A14000000000010F" type: "item" item: "farmersdelight:cabbage" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000010F" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A130000000000110"
			title: "Ciasto na wypiek"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Ciasto na wypiek”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 16.0d
			icon: "farmersdelight:pie_crust"
