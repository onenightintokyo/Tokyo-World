	quests: [
		{
			id: "A130000000000055"
			title: "Pierwsza rama maszynowa"
			description: ["Maszyny mogą pracować również tam, gdzie wcześniej potrzebna była motyka. Zbuduj uprawy, które nie wymagają ciągłego doglądania. Zacznij od sprawy „Pierwsza rama maszynowa”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "industrialforegoing:machine_frame_pity"
			dependencies: ["A130000000000018"]
			tasks: [{ id: "A140000000000055" type: "item" item: "industrialforegoing:machine_frame_pity" count: 2L consume_items: false }]
			rewards: [{ id: "A150000000000055" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A130000000000056"
			title: "Lateks i plastik"
			description: ["Gospodarstwo staje się coraz większe, więc nawet drobiazg potrafi ułatwić cały dzień. Kolejny punkt planu to „Lateks i plastik”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "industrialforegoing:latex_processing_unit"
			dependencies: ["A130000000000055"]
			tasks: [{ id: "A140000000000056" type: "item" item: "industrialforegoing:latex_processing_unit" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000056" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A130000000000057"
			title: "Płyty plastikowe"
			description: ["Jeśli chcesz wyruszać na dłużej, gospodarstwo musi umieć działać bez ciebie. Warto teraz pomyśleć o „Płyty plastikowe”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "industrialforegoing:plastic"
			dependencies: ["A130000000000055"]
			tasks: [{ id: "A140000000000057" type: "item" item: "industrialforegoing:plastic" count: 24L consume_items: false }]
			rewards: [{ id: "A150000000000057" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A130000000000058"
			title: "Rama prosta"
			description: ["Zbiór to dopiero połowa pracy. Trzeba jeszcze wiedzieć, co zrobić z plonami. Zapisz w planie „Rama prosta”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "industrialforegoing:machine_frame_simple"
			dependencies: ["A130000000000056"]
			tasks: [{ id: "A140000000000058" type: "item" item: "industrialforegoing:machine_frame_simple" count: 2L consume_items: false }]
			rewards: [{ id: "A150000000000058" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A130000000000059"
			title: "Automatyczny siewnik"
			description: ["Wcześniej zamknąłeś już sprawę „Płyty plastikowe”. Pszczoły i rośliny nie znają harmonogramu fabryki. Warto nauczyć się ich rytmu. Tym razem liczy się „Automatyczny siewnik”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "industrialforegoing:plant_sower"
			dependencies: ["A130000000000057"]
			tasks: [{ id: "A140000000000059" type: "item" item: "industrialforegoing:plant_sower" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000059" type: "item" item: "minecraft:honeycomb" count: 8 }]
		}
		{
			id: "A13000000000005A"
			title: "Automatyczny zbiór"
