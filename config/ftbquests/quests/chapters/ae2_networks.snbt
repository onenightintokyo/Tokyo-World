	quests: [
		{
			id: "A130000000000117"
			title: "Krysztaly Certus"
			description: ["Magazyn może zapamiętać więcej, niż potrafisz policzyć. Zacznij od kryształów i naucz je współpracować. Zacznij od sprawy „Krysztaly Certus”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "ae2:certus_quartz_crystal"
			dependencies: ["A130000000000018", "A130000000000044"]
			tasks: [{ id: "A140000000000117" type: "item" item: "ae2:certus_quartz_crystal" count: 24L consume_items: false }]
			rewards: [{ id: "A150000000000117" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000118"
			title: "Ladowanie krysztalow"
			description: ["W sieci każdy przewód i każda skrzynia musi mieć swoje miejsce. W notatkach pojawia się „Ladowanie krysztalow”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 1.0d
			y: 4.0d
			icon: "ae2:charged_certus_quartz_crystal"
			dependencies: ["A130000000000117"]
			tasks: [{ id: "A140000000000118" type: "item" item: "ae2:charged_certus_quartz_crystal" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000118" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000119"
			title: "Paliwo sieci Fluix"
			description: ["Czas zadbać nie tylko o moc, ale też o drogę, którą mają popłynąć zasoby. Kolejny punkt planu to „Paliwo sieci Fluix”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 15.0d
			y: 4.0d
			icon: "ae2:fluix_crystal"
			dependencies: ["A130000000000117"]
			tasks: [{ id: "A140000000000119" type: "item" item: "ae2:fluix_crystal" count: 12L consume_items: false }]
			rewards: [{ id: "A150000000000119" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A13000000000011A"
			title: "Prasa obwodow"
			description: ["Na tablicy sterowania pojawia się kolejny sygnał, którego trzeba pilnować. Warto teraz pomyśleć o „Prasa obwodow”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
			x: 1.0d
			y: 8.0d
			icon: "ae2:inscriber"
			dependencies: ["A130000000000118"]
			tasks: [{ id: "A14000000000011A" type: "item" item: "ae2:inscriber" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000011A" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A13000000000011B"
			title: "Procesory logiczne"
			description: ["Wcześniej zamknąłeś już sprawę „Paliwo sieci Fluix”. Gdy maszyny ruszą równocześnie, szybko wyjdzie na jaw najsłabsza część instalacji. Zapisz w planie „Procesory logiczne”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 15.0d
			y: 8.0d
			icon: "ae2:logic_processor"
			dependencies: ["A130000000000119"]
			tasks: [{ id: "A14000000000011B" type: "item" item: "ae2:logic_processor" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000011B" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A13000000000011C"
			title: "Procesory obliczeniowe"
			description: ["Dobrze zaplanowany magazyn potrafi oszczędzić więcej czasu niż nowa koparka. Tym razem liczy się „Procesory obliczeniowe”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
