		{
			id: "A13000000000011A"
			title: "Prasa obwodow"
			description: ["Zanim rozstawisz resztę warsztatu, uporządkuj „Prasa obwodow” na tyle solidnie, żeby nie trzeba było do tego wracać po godzinie."]
