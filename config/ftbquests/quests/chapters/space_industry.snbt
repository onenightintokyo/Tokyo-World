		}
		{
			id: "A1300000000000C0"
			title: "Generator wyprawowy"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Generator wyprawowy”. Nie wszystko, co świeci w ciemności, jest skarbem."]
