			rewards: [{ id: "A1500000000000C0" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000C1"
			title: "Warsztat rakietowy"
			description: ["Wcześniej udało ci się już zamknąć temat „Kompresor technologiczny”. Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Warsztat rakietowy”. Dobra wyprawa zaczyna się dużo wcześniej niż przy wejściu do lochu."]
			x: 15.0d
			y: 8.0d
