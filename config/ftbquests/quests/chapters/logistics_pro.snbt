			rewards: [{ id: "A1500000000000EE" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000EF"
			title: "Rury uniwersalne"
			description: ["Wcześniej udało ci się już zamknąć temat „Rury energetyczne”. Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Rury uniwersalne”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 15.0d
			y: 8.0d
			icon: "pipez:universal_pipe"
