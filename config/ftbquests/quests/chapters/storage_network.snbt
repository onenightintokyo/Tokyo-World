			dependencies: ["A1300000000000DC"]
			tasks: [{ id: "A1400000000000DE" type: "item" item: "sophisticatedstorage:storage_io" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DE" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000DF"
			title: "Wejście magazynu"
			description: ["Przy większej produkcji drobiazgi decydują o wszystkim. Wróć do tematu „Wejście magazynu” zamiast szukać obejścia przy każdym nowym urządzeniu."]
			x: 15.0d
			y: 8.0d
			icon: "sophisticatedstorage:storage_input"
			dependencies: ["A1300000000000DD"]
			tasks: [{ id: "A1400000000000DF" type: "item" item: "sophisticatedstorage:storage_input" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DF" type: "item" item: "minecraft:experience_bottle" count: 8 }]
		}
		{
			id: "A1300000000000E0"
			title: "Wyjście magazynu"
			description: ["Najlepsze rozwiązania bywają niepozorne. Przyjrzyj się „Wyjście magazynu” zanim kolejny pomysł zamieni się w stertę niedokończonych maszyn."]
			x: 1.0d
