			rewards: [{ id: "A1500000000000E1" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000E2"
			title: "Plecak miedziany"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Plecak miedziany”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 16.0d
			icon: "sophisticatedbackpacks:copper_backpack"
			dependencies: ["A1300000000000E0", "A1300000000000E1"]
