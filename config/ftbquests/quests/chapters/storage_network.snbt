		}
		{
			id: "A1300000000000DD"
			title: "Kontroler magazynu"
			description: ["Tu nie chodzi o przypadkową sztabkę z kolejnej skrzyni. Zadbaj o „Kontroler magazynu” i pomyśl, jak ten element przyda ci się przy następnej budowie."]
			x: 15.0d
			y: 4.0d
			icon: "sophisticatedstorage:controller"
