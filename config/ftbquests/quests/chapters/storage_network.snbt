		{
			id: "A1300000000000DC"
			title: "Złącze magazynu"
			description: ["Nie wszystko da się zrobić jedną maszyną. Zajmij się „Złącze magazynu” — teraz pracujesz już nad prawdziwym systemem."]
			x: 1.0d
			y: 4.0d
			icon: "sophisticatedstorage:storage_connector"
