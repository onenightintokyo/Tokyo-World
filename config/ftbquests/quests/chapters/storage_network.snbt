	quests: [
		{
			id: "A1300000000000DB"
			title: "Narzędzie magazynowe"
			description: ["Najważniejszy przedmiot zawsze jest w ostatniej skrzyni. Można to zmienić, jeśli magazyn zacznie działać jak system. Zacznij od sprawy „Narzędzie magazynowe”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "sophisticatedstorage:storage_tool"
			dependencies: ["A130000000000008"]
			tasks: [{ id: "A1400000000000DB" type: "item" item: "sophisticatedstorage:storage_tool" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DB" type: "item" item: "minecraft:lapis_lazuli" count: 8 }]
		}
		{
			id: "A1300000000000DC"
			title: "Złącze magazynu"
			description: ["Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Złącze magazynu”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 1.0d
			y: 4.0d
			icon: "sophisticatedstorage:storage_connector"
			dependencies: ["A1300000000000DB"]
			tasks: [{ id: "A1400000000000DC" type: "item" item: "sophisticatedstorage:storage_connector" count: 2L consume_items: false }]
			rewards: [{ id: "A1500000000000DC" type: "item" item: "minecraft:slime_ball" count: 4 }]
		}
		{
			id: "A1300000000000DD"
			title: "Kontroler magazynu"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Kontroler magazynu”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 15.0d
			y: 4.0d
			icon: "sophisticatedstorage:controller"
			dependencies: ["A1300000000000DB"]
			tasks: [{ id: "A1400000000000DD" type: "item" item: "sophisticatedstorage:controller" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DD" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000000DE"
			title: "Wejście i wyjście"
			description: ["Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Wejście i wyjście”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
			x: 1.0d
			y: 8.0d
			icon: "sophisticatedstorage:storage_io"
			dependencies: ["A1300000000000DC"]
			tasks: [{ id: "A1400000000000DE" type: "item" item: "sophisticatedstorage:storage_io" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DE" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000DF"
			title: "Wejście magazynu"
			description: ["Wcześniej udało ci się już zamknąć temat „Kontroler magazynu”. Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Wejście magazynu”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 15.0d
			y: 8.0d
			icon: "sophisticatedstorage:storage_input"
			dependencies: ["A1300000000000DD"]
			tasks: [{ id: "A1400000000000DF" type: "item" item: "sophisticatedstorage:storage_input" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000DF" type: "item" item: "minecraft:experience_bottle" count: 8 }]
		}
		{
			id: "A1300000000000E0"
			title: "Wyjście magazynu"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Wyjście magazynu”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 1.0d
			y: 12.0d
			icon: "sophisticatedstorage:storage_output"
