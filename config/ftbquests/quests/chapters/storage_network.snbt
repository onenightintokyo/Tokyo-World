			rewards: [{ id: "A1500000000000E0" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000000E1"
			title: "Pierwszy plecak"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Pierwszy plecak”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
			x: 15.0d
			y: 12.0d
			icon: "sophisticatedbackpacks:backpack"
