		}
		{
			id: "A1300000000000DE"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Wejście i wyjście"
			description: ["Na tablicy sterowania pojawia się kolejny sygnał, którego trzeba pilnować. Warto teraz pomyśleć o „Wejście i wyjście”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
