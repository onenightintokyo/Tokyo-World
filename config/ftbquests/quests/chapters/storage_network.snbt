		}
		{
			id: "A1300000000000DD"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Kontroler magazynu"
			description: ["Czas zadbać nie tylko o moc, ale też o drogę, którą mają popłynąć zasoby. Kolejny punkt planu to „Kontroler magazynu”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 15.0d
			y: 4.0d
			icon: "sophisticatedstorage:controller"
