			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Narzędzie magazynowe"
			description: ["Najważniejszy przedmiot zawsze jest w ostatniej skrzyni. Można to zmienić, jeśli magazyn zacznie działać jak system. Zacznij od sprawy „Narzędzie magazynowe”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "sophisticatedstorage:storage_tool"
