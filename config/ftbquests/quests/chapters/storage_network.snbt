			rewards: [{ id: "A1500000000000E0" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000000E1"
			title: "Pierwszy plecak"
			description: ["W fabryce zawsze znajdzie się jakieś wąskie gardło. Spróbuj wykorzystać „Pierwszy plecak” i spróbuj od razu znaleźć dla tego zastosowanie w bazie."]
