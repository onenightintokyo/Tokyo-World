		{
			id: "A1300000000000DE"
			title: "Wejście i wyjście"
			description: ["Zanim rozstawisz resztę warsztatu, uporządkuj „Wejście i wyjście” na tyle solidnie, żeby nie trzeba było do tego wracać po godzinie."]
			x: 1.0d
			y: 8.0d
