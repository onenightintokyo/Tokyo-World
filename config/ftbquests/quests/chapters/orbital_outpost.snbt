			rewards: [{ id: "A1500000000001D8" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000001D9"
			title: "Prasy komponentów"
			description: ["Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Prasy komponentów”. Przygotuj się tak, żeby było czym wrócić, nie tylko z czym wyruszyć."]
			x: 15.0d
			y: 4.0d
			icon: "ad_astra:compressor"
			dependencies: ["A1300000000001D7"]
			tasks: [{ id: "A1400000000001D9" type: "item" item: "ad_astra:compressor" count: 4L consume_items: false }, { id: "A1800000000001D9" type: "item" item: "minecraft:torch" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001D9" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A1300000000001DA"
			title: "Silniki rakietowe"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Silniki rakietowe”. Nie wszystko, co świeci w ciemności, jest skarbem."]
			x: 1.0d
			y: 8.0d
			icon: "ad_astra:steel_engine"
			dependencies: ["A1300000000001D8"]
			tasks: [{ id: "A1400000000001DA" type: "item" item: "ad_astra:steel_engine" count: 4L consume_items: false }, { id: "A1800000000001DA" type: "item" item: "minecraft:golden_carrot" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001DA" type: "item" item: "minecraft:ender_pearl" count: 8 }]
		}
		{
			id: "A1300000000001DB"
			title: "Stateczniki"
			description: ["Wcześniej udało ci się już zamknąć temat „Prasy komponentów”. Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Stateczniki”. Dobra wyprawa zaczyna się dużo wcześniej niż przy wejściu do lochu."]
			x: 15.0d
			y: 8.0d
			icon: "ad_astra:rocket_fin"
			dependencies: ["A1300000000001D9"]
			tasks: [{ id: "A1400000000001DB" type: "item" item: "ad_astra:rocket_fin" count: 16L consume_items: false }, { id: "A1800000000001DB" type: "item" item: "minecraft:golden_carrot" count: 16L consume_items: false }]
			rewards: [{ id: "A1500000000001DB" type: "item" item: "minecraft:emerald" count: 4 }]
		}
		{
			id: "A1300000000001DC"
			title: "Stoły NASA"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Stoły NASA”. Przygotuj się tak, żeby było czym wrócić, nie tylko z czym wyruszyć."]
			x: 1.0d
			y: 12.0d
			icon: "ad_astra:nasa_workbench"
