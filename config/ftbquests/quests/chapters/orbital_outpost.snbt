	quests: [
		{
			id: "A1300000000001D7"
			title: "Stal lotnicza"
			description: ["Sam lot w kosmos nie jest jeszcze zwycięstwem. Prawdziwy sukces to miejsce, gdzie można bezpiecznie zostać. Zacznij od sprawy „Stal lotnicza”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "ad_astra:steel_ingot"
