			tasks: [{ id: "A1400000000001DC" type: "item" item: "ad_astra:nasa_workbench" count: 2L consume_items: false }, { id: "A1800000000001DC" type: "item" item: "minecraft:golden_carrot" count: 16L consume_items: false }]
			rewards: [{ id: "A1500000000001DC" type: "item" item: "minecraft:diamond" count: 1 }]
		}
		{
			id: "A1300000000001DD"
			title: "Rafinerie paliwa"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Rafinerie paliwa”. Nie wszystko, co świeci w ciemności, jest skarbem."]
			x: 15.0d
			y: 12.0d
			icon: "ad_astra:fuel_refinery"
			dependencies: ["A1300000000001DB"]
