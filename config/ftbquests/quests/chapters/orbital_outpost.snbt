			rewards: [{ id: "A1500000000001DD" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A1300000000001DE"
			title: "Generator bazy"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Generator bazy”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem. Przygotuj wyprawę lub bazę i sprawdź jej działanie poza bezpiecznym warsztatem. Po sprawdzeniu potwierdź wykonanie znacznikiem w questbooku."]
			x: 8.0d
			y: 16.0d
			icon: "ad_astra:coal_generator"
			dependencies: ["A1300000000001DC", "A1300000000001DD"]
			tasks: [{ id: "A1400000000001DE" type: "item" item: "ad_astra:coal_generator" count: 6L consume_items: false }, { id: "A1800000000001DE" type: "item" item: "minecraft:iron_ingot" count: 16L consume_items: false }, { id: "A1D00000000001DE" type: "checkmark" }]
			rewards: [{ id: "A1500000000001DE" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A1300000000001DF"
			title: "Urządzenia tlenowe"
			description: ["Wcześniej udało ci się już zamknąć temat „Generator bazy”. Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Urządzenia tlenowe”. Przygotuj się tak, żeby było czym wrócić, nie tylko z czym wyruszyć."]
