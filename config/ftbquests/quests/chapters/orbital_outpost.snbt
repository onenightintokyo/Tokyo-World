			rewards: [{ id: "A1500000000001D7" type: "item" item: "minecraft:diamond" count: 1 }]
		}
		{
			id: "A1300000000001D8"
			title: "Płyty poszycia"
			description: ["Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Płyty poszycia”. Dobra wyprawa zaczyna się dużo wcześniej niż przy wejściu do lochu."]
			x: 1.0d
			y: 4.0d
			icon: "ad_astra:steel_plate"
