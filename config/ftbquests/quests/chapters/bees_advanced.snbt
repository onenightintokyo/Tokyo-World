			rewards: [{ id: "A1500000000000B7" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000B8"
			title: "Rozmnażanie pszczół"
			description: ["Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Rozmnażanie pszczół”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 16.0d
			icon: "productivebees:breeding_chamber"
			dependencies: ["A1300000000000B6"]
			tasks: [{ id: "A1400000000000B8" type: "item" item: "productivebees:breeding_chamber" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B8" type: "item" item: "minecraft:honeycomb" count: 4 }]
		}
		{
			id: "A1300000000000B9"
			title: "Wirówka podgrzewana"
			description: ["Wcześniej udało ci się już zamknąć temat „Rozlewnia miodu”. Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Wirówka podgrzewana”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 1.0d
