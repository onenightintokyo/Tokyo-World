			rewards: [{ id: "A1500000000000B4" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000B5"
			title: "Wirówka miodowa"
			description: ["Nie przyspieszaj na siłę. Tu warto dopracować „Wirówka miodowa” — teraz pracujesz już nad prawdziwym systemem."]
			x: 15.0d
			y: 8.0d
