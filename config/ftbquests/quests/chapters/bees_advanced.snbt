	quests: [
		{
			id: "A1300000000000B1"
			title: "Leśne gniazdo"
			description: ["Pszczoły nie znają grafiku pracownika, a jednak dostarczają niesamowite zasoby. Przygotuj im odpowiednie warunki. Zacznij od sprawy „Leśne gniazdo”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "productivebees:oak_wood_nest"
			dependencies: ["A13000000000001A"]
			tasks: [{ id: "A1400000000000B1" type: "item" item: "productivebees:oak_wood_nest" count: 2L consume_items: false }]
			rewards: [{ id: "A1500000000000B1" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A1300000000000B2"
			title: "Gniazdo trzmieli"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Gniazdo trzmieli”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "productivebees:bumble_bee_nest"
			dependencies: ["A1300000000000B1"]
			tasks: [{ id: "A1400000000000B2" type: "item" item: "productivebees:bumble_bee_nest" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B2" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A1300000000000B3"
			title: "Łapacz pszczół"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Łapacz pszczół”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "productivebees:catcher"
			dependencies: ["A1300000000000B1"]
			tasks: [{ id: "A1400000000000B3" type: "item" item: "productivebees:catcher" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B3" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A1300000000000B4"
			title: "Pasieka bambusowa"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Pasieka bambusowa”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "productivebees:bamboo_hive"
			dependencies: ["A1300000000000B2"]
			tasks: [{ id: "A1400000000000B4" type: "item" item: "productivebees:bamboo_hive" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B4" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000B5"
			title: "Wirówka miodowa"
			description: ["Wcześniej udało ci się już zamknąć temat „Łapacz pszczół”. Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Wirówka miodowa”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "productivebees:centrifuge"
			dependencies: ["A1300000000000B3"]
			tasks: [{ id: "A1400000000000B5" type: "item" item: "productivebees:centrifuge" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B5" type: "item" item: "minecraft:honeycomb" count: 8 }]
		}
		{
			id: "A1300000000000B6"
			title: "Wirówka elektryczna"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Wirówka elektryczna”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 12.0d
			icon: "productivebees:powered_centrifuge"
			dependencies: ["A1300000000000B4", "A1300000000000B5"]
			tasks: [{ id: "A1400000000000B6" type: "item" item: "productivebees:powered_centrifuge" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B6" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A1300000000000B7"
			title: "Rozlewnia miodu"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Rozlewnia miodu”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 16.0d
			icon: "productivebees:bottler"
