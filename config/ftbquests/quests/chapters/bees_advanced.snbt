			rewards: [{ id: "A1500000000000B1" type: "item" item: "minecraft:golden_carrot" count: 8 }]
		}
		{
			id: "A1300000000000B2"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Gniazdo trzmieli"
			description: ["Gospodarstwo staje się coraz większe, więc nawet drobiazg potrafi ułatwić cały dzień. Kolejny punkt planu to „Gniazdo trzmieli”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "productivebees:bumble_bee_nest"
			dependencies: ["A1300000000000B1"]
			tasks: [{ id: "A1400000000000B2" type: "item" item: "productivebees:bumble_bee_nest" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B2" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A1300000000000B3"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Łapacz pszczół"
			description: ["Jeśli chcesz wyruszać na dłużej, gospodarstwo musi umieć działać bez ciebie. Warto teraz pomyśleć o „Łapacz pszczół”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "productivebees:catcher"
			dependencies: ["A1300000000000B1"]
			tasks: [{ id: "A1400000000000B3" type: "item" item: "productivebees:catcher" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B3" type: "item" item: "minecraft:bone_meal" count: 4 }]
		}
		{
			id: "A1300000000000B4"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Pasieka bambusowa"
			description: ["Zbiór to dopiero połowa pracy. Trzeba jeszcze wiedzieć, co zrobić z plonami. Zapisz w planie „Pasieka bambusowa”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "productivebees:bamboo_hive"
			dependencies: ["A1300000000000B2"]
			tasks: [{ id: "A1400000000000B4" type: "item" item: "productivebees:bamboo_hive" count: 1L consume_items: false }]
			rewards: [{ id: "A1500000000000B4" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000000B5"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Wirówka miodowa"
			description: ["Wcześniej zamknąłeś już sprawę „Łapacz pszczół”. Pszczoły i rośliny nie znają harmonogramu fabryki. Warto nauczyć się ich rytmu. Tym razem liczy się „Wirówka miodowa”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "productivebees:centrifuge"
			dependencies: ["A1300000000000B3"]
