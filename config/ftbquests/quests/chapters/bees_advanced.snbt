		}
		{
			id: "A1300000000000B4"
			title: "Pasieka bambusowa"
			description: ["W fabryce zawsze znajdzie się jakieś wąskie gardło. Spróbuj wykorzystać „Pasieka bambusowa” zanim przejdziesz dalej. Później wszystko powinno się ze sobą połączyć."]
			x: 1.0d
