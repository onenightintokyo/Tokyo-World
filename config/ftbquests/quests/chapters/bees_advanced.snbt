		}
		{
			id: "A1300000000000B2"
			title: "Gniazdo trzmieli"
			description: ["Przy większej produkcji drobiazgi decydują o wszystkim. Wróć do tematu „Gniazdo trzmieli” i daj sobie chwilę na sprawdzenie efektu."]
			x: 1.0d
			y: 4.0d
