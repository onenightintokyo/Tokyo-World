	quests: [
		{
			id: "A130000000000157"
			title: "Pierwszy sygnał"
			description: ["Samo uruchomienie urządzenia to za mało. Czas nauczyć całą instalację, kiedy powinna działać i gdzie skierować materiały. Zacznij od sprawy „Pierwszy sygnał”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "minecraft:repeater"
			dependencies: ["A130000000000080", "A130000000000030"]
			tasks: [{ id: "A140000000000157" type: "item" item: "minecraft:repeater" count: 16L consume_items: false }, { id: "A180000000000157" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000157" type: "item" item: "minecraft:emerald" count: 8 }]
		}
		{
			id: "A130000000000158"
			title: "Czujniki sieci"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Czujniki sieci”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 1.0d
			y: 4.0d
			icon: "minecraft:comparator"
			dependencies: ["A130000000000157"]
			tasks: [{ id: "A140000000000158" type: "item" item: "minecraft:comparator" count: 16L consume_items: false }, { id: "A180000000000158" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000158" type: "item" item: "create:andesite_alloy" count: 4 }]
		}
		{
			id: "A130000000000159"
			title: "Przekaźniki danych"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Przekaźniki danych”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
			x: 15.0d
			y: 4.0d
			icon: "integrateddynamics:cable"
			dependencies: ["A130000000000157"]
			tasks: [{ id: "A140000000000159" type: "item" item: "integrateddynamics:cable" count: 24L consume_items: false }, { id: "A180000000000159" type: "item" item: "minecraft:redstone" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000159" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A13000000000015A"
			title: "Programowanie reguł"
			description: ["Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Programowanie reguł”. Jeśli cały układ ma pracować sam, każde połączenie musi mieć sens."]
			x: 1.0d
			y: 8.0d
			icon: "integrateddynamics:logic_programmer"
			dependencies: ["A130000000000158"]
			tasks: [{ id: "A14000000000015A" type: "item" item: "integrateddynamics:logic_programmer" count: 2L consume_items: false }, { id: "A18000000000015A" type: "item" item: "minecraft:copper_ingot" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000015A" type: "item" item: "minecraft:ender_pearl" count: 8 }]
		}
		{
			id: "A13000000000015B"
			title: "Pamięć zmiennych"
			description: ["Wcześniej udało ci się już zamknąć temat „Przekaźniki danych”. Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Pamięć zmiennych”. Pomyśl, gdzie popłynie ruch, zanim ustawisz następny mechanizm."]
			x: 15.0d
			y: 8.0d
			icon: "integrateddynamics:variable"
			dependencies: ["A130000000000159"]
			tasks: [{ id: "A14000000000015B" type: "item" item: "integrateddynamics:variable" count: 16L consume_items: false }, { id: "A18000000000015B" type: "item" item: "minecraft:copper_ingot" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000015B" type: "item" item: "minecraft:diamond" count: 1 }]
		}
		{
			id: "A13000000000015C"
			title: "Magazyn logiki"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Magazyn logiki”. Dobrze, żeby materiał nie zatrzymywał się w połowie drogi."]
			x: 1.0d
			y: 12.0d
