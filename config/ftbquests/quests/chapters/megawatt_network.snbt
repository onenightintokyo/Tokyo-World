			rewards: [{ id: "A15000000000018D" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A13000000000018E"
			title: "Pręty energetyczne"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Pręty energetyczne”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem. Podłącz urządzenia i zobacz, czy zasilanie lub przepływ przedmiotów działa bez ręcznej pomocy. Po sprawdzeniu potwierdź wykonanie znacznikiem w questbooku."]
			x: 8.0d
			y: 16.0d
			icon: "powah:energizing_rod_starter"
