			rewards: [{ id: "A150000000000188" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000189"
			title: "Stalowe obudowy"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Stalowe obudowy”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 15.0d
			y: 4.0d
			icon: "mekanism:steel_casing"
