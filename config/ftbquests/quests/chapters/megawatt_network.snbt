			rewards: [{ id: "A15000000000018C" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A13000000000018D"
			title: "Sfery energetyczne"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Sfery energetyczne”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
			x: 15.0d
			y: 12.0d
			icon: "powah:energizing_orb"
			dependencies: ["A13000000000018B"]
