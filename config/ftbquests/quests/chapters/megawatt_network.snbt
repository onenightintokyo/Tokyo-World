			rewards: [{ id: "A150000000000189" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A13000000000018A"
			title: "Generatory cieplne"
			description: ["Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Generatory cieplne”. Zadbaj o zapas i drogę awaryjną, zanim podłączysz kolejną maszynę."]
			x: 1.0d
			y: 8.0d
			icon: "powah:thermo_generator_starter"
			dependencies: ["A130000000000188"]
			tasks: [{ id: "A14000000000018A" type: "item" item: "powah:thermo_generator_starter" count: 8L consume_items: false }, { id: "A18000000000018A" type: "item" item: "minecraft:iron_ingot" count: 8L consume_items: false }]
			rewards: [{ id: "A15000000000018A" type: "item" item: "ae2:fluix_crystal" count: 8 }]
		}
		{
			id: "A13000000000018B"
			title: "Panele słoneczne"
			description: ["Wcześniej udało ci się już zamknąć temat „Stalowe obudowy”. Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Panele słoneczne”. Skrzynie, kable i sterowniki muszą w końcu mówić jednym językiem."]
			x: 15.0d
			y: 8.0d
			icon: "powah:solar_panel_starter"
			dependencies: ["A130000000000189"]
			tasks: [{ id: "A14000000000018B" type: "item" item: "powah:solar_panel_starter" count: 8L consume_items: false }, { id: "A18000000000018B" type: "item" item: "minecraft:iron_ingot" count: 16L consume_items: false }]
			rewards: [{ id: "A15000000000018B" type: "item" item: "minecraft:emerald" count: 4 }]
		}
		{
			id: "A13000000000018C"
			title: "Elektroliza wodna"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Elektroliza wodna”. Dobry system powinien wiedzieć, gdzie wysłać to, co właśnie wyprodukowałeś."]
			x: 1.0d
			y: 12.0d
			icon: "mekanism:electrolytic_separator"
