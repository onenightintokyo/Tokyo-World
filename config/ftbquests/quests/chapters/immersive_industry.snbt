		}
		{
			id: "A130000000000046"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Produkcja stali"
			description: ["Huta nabiera rozpędu. Przy takiej temperaturze na prowizorkę nie ma już miejsca. Tym razem liczy się „Produkcja stali”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 1.0d
			y: 4.0d
			icon: "immersiveengineering:ingot_steel"
			dependencies: ["A130000000000045"]
			tasks: [{ id: "A140000000000046" type: "item" item: "immersiveengineering:ingot_steel" count: 24L consume_items: false }]
			rewards: [{ id: "A150000000000046" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A130000000000047"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Warsztat inżyniera"
			description: ["Stal w skrzyniach niczego nie zmieni, dopóki nie zacznie pracować w konstrukcji. W notatkach pojawia się „Warsztat inżyniera”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 15.0d
			y: 4.0d
			icon: "immersiveengineering:workbench"
			dependencies: ["A130000000000045"]
			tasks: [{ id: "A140000000000047" type: "item" item: "immersiveengineering:workbench" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000047" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A130000000000048"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Przewody miedziane"
			description: ["Nawet najdroższa maszyna stanie, gdy zabraknie jej jednego porządnego elementu. Kolejny punkt planu to „Przewody miedziane”. W hucie błędy kosztują sporo paliwa i jeszcze więcej cierpliwości."]
			x: 1.0d
			y: 8.0d
