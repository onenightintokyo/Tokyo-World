		}
		{
			id: "A13000000000004A"
			title: "Akumulator LV"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Akumulator LV”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
