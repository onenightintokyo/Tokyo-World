			rewards: [{ id: "A150000000000091" type: "item" item: "minecraft:blaze_powder" count: 8 }]
		}
		{
			id: "A130000000000092"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Klejnot źródła"
			description: ["Mana i Source potrafią wiele, jeśli nie próbujesz zmuszać ich do pośpiechu. Warto teraz pomyśleć o „Klejnot źródła”. Kiedy już zrozumiesz źródło tej mocy, spróbuj wykorzystać je w bazie."]
			x: 1.0d
			y: 4.0d
			icon: "ars_nouveau:source_gem"
			dependencies: ["A130000000000091"]
			tasks: [{ id: "A140000000000092" type: "item" item: "ars_nouveau:source_gem" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000092" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A130000000000093"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Magazyn Source"
			description: ["Nie każda moc daje się zamknąć w kablu. Tu przydają się uważne próby i eksperymenty. Zapisz w planie „Magazyn Source”. Nawet najprostszy rytuał jest ciekawszy, gdy wiesz, po co go wykonujesz."]
			x: 15.0d
			y: 4.0d
			icon: "ars_nouveau:source_jar"
			dependencies: ["A130000000000091"]
			tasks: [{ id: "A140000000000093" type: "item" item: "ars_nouveau:source_jar" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000093" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000094"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Komora nasycania"
			description: ["Rytuał wymaga czegoś więcej niż przypadkowo ułożonych składników. Tym razem liczy się „Komora nasycania”. Nie traktuj magii jak zwykłego przepisu — jej działanie często wymaga cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "ars_nouveau:imbuement_chamber"
			dependencies: ["A130000000000092"]
			tasks: [{ id: "A140000000000094" type: "item" item: "ars_nouveau:imbuement_chamber" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000094" type: "item" item: "minecraft:blaze_powder" count: 4 }]
		}
		{
			id: "A130000000000095"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Aparat zaklinania"
			description: ["Wcześniej zamknąłeś już sprawę „Magazyn Source”. W świecie magii najciekawsze odkrycia często zaczynają się od drobnej zmiany. W notatkach pojawia się „Aparat zaklinania”. Kiedy już zrozumiesz źródło tej mocy, spróbuj wykorzystać je w bazie."]
			x: 15.0d
			y: 8.0d
