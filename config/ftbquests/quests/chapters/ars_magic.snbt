		{
			id: "A130000000000095"
			title: "Aparat zaklinania"
			description: ["Każda nowa maszyna stawia własne wymagania. Sprawdź, co daje „Aparat zaklinania” i daj sobie chwilę na sprawdzenie efektu."]
			x: 15.0d
			y: 8.0d
			icon: "ars_nouveau:enchanting_apparatus"
