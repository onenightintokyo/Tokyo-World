		}
		{
			id: "A130000000000092"
			title: "Klejnot źródła"
			description: ["Nie przyspieszaj na siłę. Tu warto dopracować „Klejnot źródła” zanim kolejny pomysł zamieni się w stertę niedokończonych maszyn."]
			x: 1.0d
			y: 4.0d
			icon: "ars_nouveau:source_gem"
