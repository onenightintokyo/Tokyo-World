			rewards: [{ id: "A150000000000091" type: "item" item: "minecraft:blaze_powder" count: 8 }]
		}
		{
			id: "A130000000000092"
			title: "Klejnot źródła"
			description: ["Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Klejnot źródła”. Kiedy już zrozumiesz źródło tej mocy, spróbuj wykorzystać je w bazie."]
			x: 1.0d
			y: 4.0d
			icon: "ars_nouveau:source_gem"
			dependencies: ["A130000000000091"]
			tasks: [{ id: "A140000000000092" type: "item" item: "ars_nouveau:source_gem" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000092" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A130000000000093"
			title: "Magazyn Source"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Magazyn Source”. Nawet najprostszy rytuał jest ciekawszy, gdy wiesz, po co go wykonujesz."]
			x: 15.0d
			y: 4.0d
			icon: "ars_nouveau:source_jar"
			dependencies: ["A130000000000091"]
			tasks: [{ id: "A140000000000093" type: "item" item: "ars_nouveau:source_jar" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000093" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000094"
			title: "Komora nasycania"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Komora nasycania”. Nie traktuj magii jak zwykłego przepisu — jej działanie często wymaga cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "ars_nouveau:imbuement_chamber"
			dependencies: ["A130000000000092"]
			tasks: [{ id: "A140000000000094" type: "item" item: "ars_nouveau:imbuement_chamber" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000094" type: "item" item: "minecraft:blaze_powder" count: 4 }]
		}
		{
			id: "A130000000000095"
			title: "Aparat zaklinania"
			description: ["Wcześniej udało ci się już zamknąć temat „Magazyn Source”. Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Aparat zaklinania”. Kiedy już zrozumiesz źródło tej mocy, spróbuj wykorzystać je w bazie."]
			x: 15.0d
			y: 8.0d
			icon: "ars_nouveau:enchanting_apparatus"
			dependencies: ["A130000000000093"]
			tasks: [{ id: "A140000000000095" type: "item" item: "ars_nouveau:enchanting_apparatus" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000095" type: "item" item: "minecraft:experience_bottle" count: 8 }]
		}
		{
			id: "A130000000000096"
			title: "Magiczne piedestały"
			description: ["Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Magiczne piedestały”. Nawet najprostszy rytuał jest ciekawszy, gdy wiesz, po co go wykonujesz."]
			x: 1.0d
			y: 12.0d
			icon: "ars_nouveau:arcane_pedestal"
