			rewards: [{ id: "A150000000000097" type: "item" item: "minecraft:blaze_powder" count: 4 }]
		}
		{
			id: "A130000000000098"
			title: "Przekazywanie Source"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Przekazywanie Source”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 16.0d
			icon: "ars_nouveau:relay"
			dependencies: ["A130000000000096", "A130000000000097"]
			tasks: [{ id: "A140000000000098" type: "item" item: "ars_nouveau:relay" count: 2L consume_items: false }]
			rewards: [{ id: "A150000000000098" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A130000000000099"
			title: "Zbieracz Source"
			description: ["Wcześniej udało ci się już zamknąć temat „Przekazywanie Source”. Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Zbieracz Source”. Nawet najprostszy rytuał jest ciekawszy, gdy wiesz, po co go wykonujesz."]
