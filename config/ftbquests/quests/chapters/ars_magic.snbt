			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Pierwsza księga zaklęć"
			description: ["Pierwszy czar jest tylko obietnicą. Prawdziwa sztuka polega na zrozumieniu Source i własnych możliwości. Zacznij od sprawy „Pierwsza księga zaklęć”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "ars_nouveau:novice_spell_book"
