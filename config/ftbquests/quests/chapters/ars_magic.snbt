		{
			id: "A130000000000091"
			title: "Pierwsza księga zaklęć"
			description: ["Pierwszy czar jest tylko obietnicą. Prawdziwa sztuka polega na zrozumieniu Source i własnych możliwości. Zacznij od „Pierwsza księga zaklęć”. Bez tego reszta planu zostanie tylko ładnym szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "ars_nouveau:novice_spell_book"
