		}
		{
			id: "A130000000000099"
			title: "Zbieracz Source"
			description: ["Przy większej produkcji drobiazgi decydują o wszystkim. Wróć do tematu „Zbieracz Source” i pomyśl, jak ten element przyda ci się przy następnej budowie."]
