		}
		{
			id: "A130000000000093"
			title: "Magazyn Source"
			description: ["Dobrze mieć pomysł, lecz jeszcze lepiej zobaczyć go w praktyce. Przygotuj „Magazyn Source” i spróbuj od razu znaleźć dla tego zastosowanie w bazie."]
			x: 15.0d
			y: 4.0d
			icon: "ars_nouveau:source_jar"
			dependencies: ["A130000000000091"]
			tasks: [{ id: "A140000000000093" type: "item" item: "ars_nouveau:source_jar" count: 1L consume_items: false }]
			rewards: [{ id: "A150000000000093" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000094"
			title: "Komora nasycania"
			description: ["Nie trzeba od razu budować wielkiego zakładu. Na razie skup się na „Komora nasycania” i zachowaj trochę na dalszą rozbudowę."]
			x: 1.0d
			y: 8.0d
			icon: "ars_nouveau:imbuement_chamber"
