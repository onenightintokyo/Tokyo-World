		}
		{
			id: "A130000000000097"
			title: "Rdzeń magiczny"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Rdzeń magiczny”. Nie traktuj magii jak zwykłego przepisu — jej działanie często wymaga cierpliwości."]
			x: 15.0d
			y: 12.0d
			icon: "ars_nouveau:arcane_core"
