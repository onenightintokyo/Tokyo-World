			tasks: [{ id: "A140000000000127" type: "item" item: "enderio:grain_of_infinity" count: 8L consume_items: false }]
			rewards: [{ id: "A150000000000127" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A130000000000128"
			title: "Podstawowy kondensator"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Podstawowy kondensator”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 1.0d
			y: 4.0d
			icon: "enderio:basic_capacitor"
			dependencies: ["A130000000000127"]
			tasks: [{ id: "A140000000000128" type: "item" item: "enderio:basic_capacitor" count: 2L consume_items: false }]
			rewards: [{ id: "A150000000000128" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000129"
			title: "Wielofunkcyjna obudowa"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Wielofunkcyjna obudowa”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 15.0d
			y: 4.0d
			icon: "enderio:void_chassis"
			dependencies: ["A130000000000127"]
			tasks: [{ id: "A140000000000129" type: "item" item: "enderio:void_chassis" count: 2L consume_items: false }]
			rewards: [{ id: "A150000000000129" type: "item" item: "minecraft:ender_pearl" count: 4 }]
		}
		{
			id: "A13000000000012A"
			title: "Przemyslowy wytapiacz"
			description: ["Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Przemyslowy wytapiacz”. W hucie błędy kosztują sporo paliwa i jeszcze więcej cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "enderio:alloy_smelter"
			dependencies: ["A130000000000128"]
			tasks: [{ id: "A14000000000012A" type: "item" item: "enderio:alloy_smelter" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000012A" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A13000000000012B"
			title: "Mlyn SAG"
			description: ["Wcześniej udało ci się już zamknąć temat „Wielofunkcyjna obudowa”. Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Mlyn SAG”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 15.0d
			y: 8.0d
			icon: "enderio:sag_mill"
			dependencies: ["A130000000000129"]
			tasks: [{ id: "A14000000000012B" type: "item" item: "enderio:sag_mill" count: 1L consume_items: false }]
			rewards: [{ id: "A15000000000012B" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A13000000000012C"
			title: "Generator Stirlinga"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Generator Stirlinga”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem."]
			x: 8.0d
			y: 12.0d
			icon: "enderio:stirling_generator"
			dependencies: ["A13000000000012A", "A13000000000012B"]
			tasks: [{ id: "A14000000000012C" type: "item" item: "enderio:stirling_generator" count: 1L consume_items: false }]
