		{
			id: "A1300000000001B7"
			title: "Plony bazowe"
			description: ["Wielkie projekty potrzebują nie tylko metalu, lecz także regularnego zaopatrzenia. Zadbaj o samowystarczalność. Zacznij od sprawy „Plony bazowe”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "minecraft:wheat"
			dependencies: ["A130000000000064", "A1300000000000B0"]
