			rewards: [{ id: "A1500000000001BC" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A1300000000001BD"
			title: "Tworzywa sztuczne"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Tworzywa sztuczne”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 15.0d
			y: 12.0d
			icon: "industrialforegoing:plastic"
			dependencies: ["A1300000000001BB"]
			tasks: [{ id: "A1400000000001BD" type: "item" item: "industrialforegoing:plastic" count: 48L consume_items: false }, { id: "A1800000000001BD" type: "item" item: "minecraft:iron_ingot" count: 16L consume_items: false }]
			rewards: [{ id: "A1500000000001BD" type: "item" item: "minecraft:emerald" count: 8 }]
		}
		{
			id: "A1300000000001BE"
			title: "Siewniki automatyczne"
			description: ["Dwie drogi rozwoju wreszcie spotykają się w jednym miejscu. Tym razem chodzi o „Siewniki automatyczne”. Dopiero gdy obie części są gotowe, możesz przekonać się, jak pracują razem. Uruchom farmę na próbę i upewnij się, że sama zbiera albo przygotowuje plony. Po sprawdzeniu potwierdź wykonanie znacznikiem w questbooku."]
			x: 8.0d
			y: 16.0d
			icon: "industrialforegoing:plant_sower"
			dependencies: ["A1300000000001BC", "A1300000000001BD"]
