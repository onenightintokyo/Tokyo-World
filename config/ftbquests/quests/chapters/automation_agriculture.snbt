			rewards: [{ id: "A1500000000001B7" type: "item" item: "minecraft:experience_bottle" count: 6 }]
		}
		{
			id: "A1300000000001B8"
			title: "Warzywa kuchenne"
			description: ["Dobry pomysł potrzebuje czegoś więcej niż kilku skrzyń z częściami. Pora zająć się „Warzywa kuchenne”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 1.0d
			y: 4.0d
			icon: "minecraft:carrot"
			dependencies: ["A1300000000001B7"]
			tasks: [{ id: "A1400000000001B8" type: "item" item: "minecraft:carrot" count: 128L consume_items: false }, { id: "A1800000000001B8" type: "item" item: "minecraft:bone_meal" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001B8" type: "item" item: "minecraft:emerald" count: 4 }]
		}
		{
			id: "A1300000000001B9"
			title: "Nawóz dla pól"
			description: ["Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Nawóz dla pól”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 15.0d
			y: 4.0d
			icon: "minecraft:bone_meal"
			dependencies: ["A1300000000001B7"]
			tasks: [{ id: "A1400000000001B9" type: "item" item: "minecraft:bone_meal" count: 96L consume_items: false }, { id: "A1800000000001B9" type: "item" item: "minecraft:bone_meal" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001B9" type: "item" item: "mysticalagriculture:inferium_essence" count: 4 }]
		}
		{
			id: "A1300000000001BA"
			title: "Lejki zbiorów"
			description: ["Każda maszyna jest tylko jednym ogniwem większej całości. Teraz liczy się „Lejki zbiorów”. Zadbaj o porządek w uprawach, żeby surowce nie ginęły między kolejnymi zbiorami."]
			x: 1.0d
			y: 8.0d
			icon: "minecraft:hopper"
			dependencies: ["A1300000000001B8"]
			tasks: [{ id: "A1400000000001BA" type: "item" item: "minecraft:hopper" count: 32L consume_items: false }, { id: "A1800000000001BA" type: "item" item: "minecraft:carrot" count: 8L consume_items: false }]
			rewards: [{ id: "A1500000000001BA" type: "item" item: "minecraft:bone_meal" count: 8 }]
		}
		{
			id: "A1300000000001BB"
			title: "Ramy maszynowe"
			description: ["Wcześniej udało ci się już zamknąć temat „Nawóz dla pól”. Zanim rozstawisz kolejne urządzenia, spójrz na to, czego wciąż brakuje. Tym razem chodzi o „Ramy maszynowe”. Najlepsze plony przychodzą wtedy, gdy pomyślisz o całym cyklu, nie tylko o zbiorach."]
			x: 15.0d
			y: 8.0d
			icon: "industrialforegoing:machine_frame_pity"
			dependencies: ["A1300000000001B9"]
			tasks: [{ id: "A1400000000001BB" type: "item" item: "industrialforegoing:machine_frame_pity" count: 8L consume_items: false }, { id: "A1800000000001BB" type: "item" item: "minecraft:carrot" count: 16L consume_items: false }]
			rewards: [{ id: "A1500000000001BB" type: "item" item: "minecraft:golden_carrot" count: 4 }]
		}
		{
			id: "A1300000000001BC"
			title: "Przetwarzanie lateksu"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Przetwarzanie lateksu”. Gdy wyjedziesz na wyprawę, gospodarstwo nadal powinno sobie radzić."]
			x: 1.0d
			y: 12.0d
			icon: "industrialforegoing:latex_processing_unit"
