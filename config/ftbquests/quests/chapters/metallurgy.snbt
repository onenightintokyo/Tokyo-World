			icon: "thermal:tin_ore"
			dependencies: ["A130000000000100", "A130000000000101"]
			tasks: [{ id: "A140000000000102" type: "item" item: "thermal:tin_ore" count: 12L consume_items: false }]
			rewards: [{ id: "A150000000000102" type: "item" item: "minecraft:experience_bottle" count: 4 }]
		}
		{
			id: "A130000000000103"
			title: "Rudy srebra"
			description: ["Wcześniej udało ci się już zamknąć temat „Rudy cyny”. Ten fragment pracy może wydawać się niepozorny, ale szybko okaże się potrzebny. Na tapecie jest „Rudy srebra”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 1.0d
			y: 20.0d
			icon: "thermal:silver_ore"
