		}
		{
			id: "A1300000000000FC"
			size: 1.65d
			icon_scale: 1.12d
			hide_dependency_lines: false
			hide_dependent_lines: false
			title: "Ołów"
			description: ["Huta nabiera rozpędu. Przy takiej temperaturze na prowizorkę nie ma już miejsca. Tym razem liczy się „Ołów”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 1.0d
