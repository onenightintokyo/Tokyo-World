	quests: [
		{
			id: "A1300000000000FB"
			title: "Cyna"
			description: ["Nie każdy metal nadaje się do każdej maszyny. Czas zrozumieć, kiedy liczy się skład materiału, a nie jego ilość. Zacznij od sprawy „Cyna”. Bez tego dalsze pomysły zostałyby tylko szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "thermal:tin_ingot"
			dependencies: ["A130000000000006"]
			tasks: [{ id: "A1400000000000FB" type: "item" item: "thermal:tin_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FB" type: "item" item: "minecraft:lapis_lazuli" count: 8 }]
		}
		{
			id: "A1300000000000FC"
			title: "Ołów"
			description: ["Najbardziej irytują te problemy, które wychodzą dopiero podczas pracy. Teraz na stole leży temat „Ołów”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 1.0d
			y: 4.0d
			icon: "thermal:lead_ingot"
			dependencies: ["A1300000000000FB"]
			tasks: [{ id: "A1400000000000FC" type: "item" item: "thermal:lead_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FC" type: "item" item: "minecraft:slime_ball" count: 4 }]
		}
		{
			id: "A1300000000000FD"
			title: "Nikiel"
			description: ["Właśnie takie rzeczy odróżniają działającą bazę od sterty maszyn. Najpierw rozwiąż „Nikiel”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 15.0d
			y: 4.0d
			icon: "thermal:nickel_ingot"
			dependencies: ["A1300000000000FB"]
			tasks: [{ id: "A1400000000000FD" type: "item" item: "thermal:nickel_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FD" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000000FE"
			title: "Srebro"
			description: ["Nie wszystko musi powstawać od razu. Na dziś najważniejszy będzie temat „Srebro”. W hucie błędy kosztują sporo paliwa i jeszcze więcej cierpliwości."]
			x: 1.0d
			y: 8.0d
			icon: "thermal:silver_ingot"
			dependencies: ["A1300000000000FC"]
			tasks: [{ id: "A1400000000000FE" type: "item" item: "thermal:silver_ingot" count: 18L consume_items: false }]
			rewards: [{ id: "A1500000000000FE" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000FF"
			title: "Elektrum"
			description: ["Wcześniej udało ci się już zamknąć temat „Nikiel”. Fabryka rośnie szybciej niż plan na papierze. Następną sprawą do ogarnięcia jest „Elektrum”. Zanim odpalisz wielką linię, przygotuj solidne komponenty."]
			x: 15.0d
			y: 8.0d
			icon: "thermal:electrum_ingot"
			dependencies: ["A1300000000000FD"]
			tasks: [{ id: "A1400000000000FF" type: "item" item: "thermal:electrum_ingot" count: 12L consume_items: false }]
			rewards: [{ id: "A1500000000000FF" type: "item" item: "minecraft:experience_bottle" count: 8 }]
		}
		{
			id: "A130000000000100"
			title: "Brąz"
			description: ["Niektórych odkryć łatwo nie docenić. Przyjrzyj się bliżej sprawie „Brąz”. Przy tej skali produkcji nawet mały przestój szybko daje się we znaki."]
			x: 1.0d
			y: 12.0d
			icon: "thermal:bronze_ingot"
			dependencies: ["A1300000000000FE"]
			tasks: [{ id: "A140000000000100" type: "item" item: "thermal:bronze_ingot" count: 12L consume_items: false }]
			rewards: [{ id: "A150000000000100" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A130000000000101"
			title: "Invar"
			description: ["Nie ma sensu przyspieszać, jeśli podstawy ciągle zawodzą. Wróć do sprawy „Invar”. W hucie błędy kosztują sporo paliwa i jeszcze więcej cierpliwości."]
			x: 15.0d
			y: 12.0d
