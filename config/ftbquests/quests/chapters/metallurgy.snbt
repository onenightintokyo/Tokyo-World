	quests: [
		{
			id: "A1300000000000FB"
			title: "Cyna"
			description: ["Nie każdy metal nadaje się do każdej maszyny. Czas zrozumieć, kiedy liczy się skład materiału, a nie jego ilość. Zacznij od „Cyna”. Bez tego reszta planu zostanie tylko ładnym szkicem."]
			x: 8.0d
			y: 0.0d
			icon: "thermal:tin_ingot"
			dependencies: ["A130000000000006"]
			tasks: [{ id: "A1400000000000FB" type: "item" item: "thermal:tin_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FB" type: "item" item: "minecraft:lapis_lazuli" count: 8 }]
		}
		{
			id: "A1300000000000FC"
			title: "Ołów"
			description: ["Dobrze mieć pomysł, lecz jeszcze lepiej zobaczyć go w praktyce. Przygotuj „Ołów” zamiast szukać obejścia przy każdym nowym urządzeniu."]
			x: 1.0d
			y: 4.0d
			icon: "thermal:lead_ingot"
			dependencies: ["A1300000000000FB"]
			tasks: [{ id: "A1400000000000FC" type: "item" item: "thermal:lead_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FC" type: "item" item: "minecraft:slime_ball" count: 4 }]
		}
		{
			id: "A1300000000000FD"
			title: "Nikiel"
			description: ["Nie trzeba od razu budować wielkiego zakładu. Na razie skup się na „Nikiel” zanim kolejny pomysł zamieni się w stertę niedokończonych maszyn."]
			x: 15.0d
			y: 4.0d
			icon: "thermal:nickel_ingot"
			dependencies: ["A1300000000000FB"]
			tasks: [{ id: "A1400000000000FD" type: "item" item: "thermal:nickel_ingot" count: 24L consume_items: false }]
			rewards: [{ id: "A1500000000000FD" type: "item" item: "minecraft:amethyst_shard" count: 4 }]
		}
		{
			id: "A1300000000000FE"
			title: "Srebro"
			description: ["Każda nowa maszyna stawia własne wymagania. Sprawdź, co daje „Srebro” i spróbuj od razu znaleźć dla tego zastosowanie w bazie."]
			x: 1.0d
			y: 8.0d
			icon: "thermal:silver_ingot"
			dependencies: ["A1300000000000FC"]
			tasks: [{ id: "A1400000000000FE" type: "item" item: "thermal:silver_ingot" count: 18L consume_items: false }]
			rewards: [{ id: "A1500000000000FE" type: "item" item: "minecraft:lapis_lazuli" count: 4 }]
		}
		{
			id: "A1300000000000FF"
			title: "Elektrum"
			description: ["Nie wszystko da się zrobić jedną maszyną. Zajmij się „Elektrum” i zachowaj trochę na dalszą rozbudowę."]
			x: 15.0d
			y: 8.0d
			icon: "thermal:electrum_ingot"
			dependencies: ["A1300000000000FD"]
			tasks: [{ id: "A1400000000000FF" type: "item" item: "thermal:electrum_ingot" count: 12L consume_items: false }]
			rewards: [{ id: "A1500000000000FF" type: "item" item: "minecraft:experience_bottle" count: 8 }]
		}
		{
			id: "A130000000000100"
			title: "Brąz"
			description: ["Tu nie chodzi o przypadkową sztabkę z kolejnej skrzyni. Zadbaj o „Brąz” i daj sobie chwilę na sprawdzenie efektu."]
			x: 1.0d
			y: 12.0d
			icon: "thermal:bronze_ingot"
