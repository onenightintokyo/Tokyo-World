      },
      {
        "project": "extreme-reactors",
        "label": "Extreme Reactors",
        "match": "^extremereactors[-_].*\\.jar$"
      },
      {
        "project": "nuclearcraft-neoteric",
        "label": "NuclearCraft Neoteric",
