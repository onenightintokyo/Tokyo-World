{
  "schema_version": 1,
  "name": "Tokyo World — Technology Expansion",
  "minecraft": "1.20.1",
  "loader": "forge",
  "note": "Profile installer is opt-in. It downloads current compatible Forge 1.20.1 files from Modrinth, validates SHA-512, preserves existing mods and never touches saves. Treat as testing until a fully pinned lockfile is produced.",
