    "tech-core": [
      {
        "project": "ae2",
        "label": "Applied Energistics 2",
        "match": "^(ae2|appliedenergistics2)[-_].*\\.jar$"
      },
      {
        "project": "enderio",
        "label": "Ender IO",
        "match": "^enderio[-_].*\\.jar$"
      },
      {
        "project": "mekanism-generators",
        "label": "Mekanism Generators",
        "match": "^mekanismgenerators[-_].*\\.jar$",
        "version": "10.4.16.80"
      },
      {
        "project": "mekanism-tools",
        "label": "Mekanism Tools",
        "match": "^mekanismtools[-_].*\\.jar$",
        "version": "10.4.16.80"
      },
      {
        "project": "mekanism-additions",
        "label": "Mekanism Additions",
        "match": "^mekanismadditions[-_].*\\.jar$",
        "version": "10.4.16.80"
      },
      {
        "project": "thermal-expansion",
        "label": "Thermal Expansion",
        "match": "^thermal_expansion[-_].*\\.jar$"
      },
      {
        "project": "pneumaticcraft-repressurized",
        "label": "PneumaticCraft: Repressurized",
        "match": "^pneumaticcraft[-_].*\\.jar$"
      }
    ],
    "tech-expanded": [
      {
        "project": "integrated-crafting",
